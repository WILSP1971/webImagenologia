# ─────────────────────────────────────────────────────────────────────────────
# webImagenologia — Orquestador Agentico
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees el archivo .env con credenciales reales.
# ─────────────────────────────────────────────────────────────────────────────

# Cursor API Key
# Obtener en: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook de notificación al Lead (opcional)
# Si está configurado, el orquestador envía un JSON con el reporte de cada fase.
# Puede ser un endpoint Slack/Teams/Telegram o un servidor local.
# Dejar vacío para deshabilitar.
LEAD_WEBHOOK_URL=

# Mostrar output del agente en tiempo real (0=no, 1=sí)
# También se puede activar con --stream desde la CLI.
STREAM_OUTPUT=0
