@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_Layout";
}

<div class="access-denied-page text-center py-5">
    <div class="access-denied-icon mx-auto mb-4" aria-hidden="true">🔒</div>
    <h1 class="h3 mb-3">No tiene permiso para esta sección</h1>
    <p class="text-muted mb-4">
        Su rol de sesión no incluye acceso a la página solicitada.
        Si cree que es un error, cierre sesión y vuelva a ingresar.
    </p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
