@model WebImagenologia.Web.Models.ViewModels.EstudiosViewModel
@{
    ViewData["Title"] = "Parametrización de Estudios";
    Layout = "_Layout";
}

<section class="param-page">
    <header class="param-page-header mb-4">
        <div>
            <p class="param-page-kicker mb-1">Parámetros</p>
            <h1 class="param-page-title h3 mb-0">Parametrización de Estudios</h1>
        </div>
        <partial name="_BotonRegresar" />
    </header>

    @if (ViewData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (ViewData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (ViewData["WarningMessage"] is string warningMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="status">
            @warningMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="param-card">
                <h2 class="param-card-title h5">Registrar estudio</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <form asp-action="RegistrarEstudio" asp-controller="Parametros" method="post" novalidate id="formEstudio">
                    <div class="mb-3">
                        <label asp-for="CodDependencia" class="form-label"></label>
                        <select asp-for="CodDependencia"
                                class="form-select"
                                id="selectDependencia"
                                aria-required="true"
                                data-dependencia-target="nombreDependencia">
                            <option value="">-- Seleccione dependencia --</option>
                            @foreach (var dependencia in Model.DependenciasDisponibles)
                            {
                                <option value="@dependencia.CodDependencia"
                                        data-nombre="@dependencia.NombreDependencia">
                                    @dependencia.NombreDependencia (@dependencia.CodDependencia)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CodDependencia" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreDependencia" class="form-label"></label>
                        <input asp-for="NombreDependencia"
                               class="form-control"
                               id="nombreDependencia"
                               readonly
                               aria-readonly="true" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cantidad" class="form-label"></label>
                        <input asp-for="Cantidad"
                               class="form-control"
                               type="number"
                               min="1"
                               step="1"
                               aria-required="true"
                               placeholder="Cantidad entera de estudios" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input type="hidden" name="EsLectura" value="false" />
                        <input asp-for="EsLectura" class="form-check-input" id="esLectura" value="true" checked />
                        <label class="form-check-label" for="esLectura">Lectura / No Lectura (marcado = Lectura)</label>
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6 mb-2">@Html.DisplayNameFor(m => m.EmpresasSeleccionadas)</legend>
                        <div class="empresas-check-group" role="group" aria-label="Empresas activas del servidor">
                            @if (Model.EmpresasDisponibles.Count == 0)
                            {
                                <p class="text-muted small mb-0">No hay empresas asignadas en su sesión.</p>
                            }
                            else
                            {
                                @foreach (var empresa in Model.EmpresasDisponibles)
                                {
                                    var inputId = $"empresa_{empresa.Codigo}";
                                    <div class="form-check">
                                        <input class="form-check-input empresa-checkbox"
                                               type="checkbox"
                                               name="EmpresasSeleccionadas"
                                               value="@empresa.Codigo"
                                               id="@inputId"
                                               data-nombre="@empresa.Nombre"
                                               @(Model.EmpresasSeleccionadas.Contains(empresa.Codigo) ? "checked" : null) />
                                        <label class="form-check-label" for="@inputId">@empresa.Etiqueta</label>
                                    </div>
                                }
                            }
                        </div>
                        <span asp-validation-for="EmpresasSeleccionadas" class="text-danger"></span>
                    </fieldset>

                    <button type="submit" class="btn btn-primary w-100">Registrar</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="param-card param-card-table">
                <h2 class="param-card-title h5">Servicios registrados</h2>

                @if (Model.EstudiosRegistrados.Count == 0)
                {
                    <p class="text-muted mb-0" role="status">No hay estudios registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 param-table" aria-label="Estudios registrados">
                            <thead>
                                <tr>
                                    <th scope="col">Empresa</th>
                                    <th scope="col">Dependencia</th>
                                    <th scope="col">Cantidad</th>
                                    <th scope="col">Lectura</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var estudio in Model.EstudiosRegistrados)
                                {
                                    var estadoLabel = estudio.Estado.Equals("A", StringComparison.OrdinalIgnoreCase)
                                        ? "Activo"
                                        : "Inactivo";
                                    <tr>
                                        <td>@estudio.NombreEmpresa</td>
                                        <td>@(string.IsNullOrWhiteSpace(estudio.NombreDependencia) ? estudio.CodDependencia : estudio.NombreDependencia)</td>
                                        <td>@estudio.Cantidad</td>
                                        <td>@estadoLabel</td>
                                        <td class="text-end text-nowrap">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-editar-estudio"
                                                    data-empresa="@estudio.Empresa"
                                                    data-nombre-empresa="@estudio.NombreEmpresa"
                                                    data-cod-dependencia="@estudio.CodDependencia"
                                                    data-nombre-dependencia="@(string.IsNullOrWhiteSpace(estudio.NombreDependencia) ? estudio.CodDependencia : estudio.NombreDependencia)"
                                                    data-cantidad="@estudio.Cantidad"
                                                    data-es-lectura="@(estudio.Estado.Equals("A", StringComparison.OrdinalIgnoreCase) ? "true" : "false")">
                                                Editar
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-eliminar-estudio"
                                                    data-empresa="@estudio.Empresa"
                                                    data-cod-dependencia="@estudio.CodDependencia"
                                                    data-cod-servicio="@estudio.CodDependencia"
                                                    data-descripcion="@estudio.NombreEmpresa — @(string.IsNullOrWhiteSpace(estudio.NombreDependencia) ? estudio.CodDependencia : estudio.NombreDependencia)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* Modal Editar Estudio *@
<div class="modal fade" id="modalEditarEstudio" tabindex="-1" aria-labelledby="modalEditarEstudioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegistrarEstudio" asp-controller="Parametros" method="post" id="formEditarEstudio" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ModoEdicion" value="true" />
                <input type="hidden" name="EmpresaEdicion" id="editEmpresa" value="" />
                <input type="hidden" name="EmpresasSeleccionadas" id="editEmpresasSel" value="" />
                <input type="hidden" name="CodDependencia" id="editCodDependencia" value="" />
                <input type="hidden" name="NombreDependencia" id="editNombreDependencia" value="" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="modalEditarEstudioLabel">Editar estudio</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Empresa</label>
                        <input type="text" class="form-control" id="editNombreEmpresa" readonly aria-readonly="true" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Dependencia</label>
                        <input type="text" class="form-control" id="editNombreDependenciaDisplay" readonly aria-readonly="true" />
                    </div>
                    <div class="mb-3">
                        <label for="editCantidad" class="form-label fw-semibold">Cantidad</label>
                        <input type="number" class="form-control" id="editCantidad" name="Cantidad"
                               min="1" step="1" aria-required="true" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="editEsLectura" name="EsLectura" value="true" />
                        <label class="form-check-label" for="editEsLectura">Lectura (marcado = Lectura activa)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Eliminar Estudio *@
<div class="modal fade" id="modalEliminarEstudio" tabindex="-1" aria-labelledby="modalEliminarEstudioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EliminarEstudio" asp-controller="Parametros" method="post" id="formEliminarEstudio">
                @Html.AntiForgeryToken()
                <input type="hidden" name="empresa" id="empresaEliminar" value="" />
                <input type="hidden" name="codDependencia" id="codDependenciaEliminar" value="" />
                <input type="hidden" name="codServicio" id="codServicioEliminar" value="" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="modalEliminarEstudioLabel">Confirmar eliminación</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p id="mensajeEliminarEstudio" class="mb-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/parametros.js" asp-append-version="true"></script>
}
